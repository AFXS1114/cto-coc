/**
 * @fileoverview Firestore Security Rules for PTO Management App.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (leave requests, WAN/COC requests) stored under user-specific paths.
 * Data concerning PTO management will be under System Admin and Record Admin roles to approve and cancel.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for a specific user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for a specific user.
 * - /to-process-leave/{leaveRequestId}: Stores leave requests that are pending review and processing.
 * - /employees/{employeeId}: Stores employee information.
 * - /app-users/{appUserId}: Stores application user credentials and roles.
 *
 * Key Security Decisions:
 * - User data is strictly private and accessible only to the authenticated user.
 * - Listing of all users is disallowed.
 * - Public listing of leave requests or WAN/COC requests is disallowed.
 *
 * Denormalization for Authorization:
 * - Ownership is enforced by path-based rules (e.g., /users/{userId}/...). The 'userId' path segment is compared against request.auth.uid.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Stores user profiles.  The 'userId' parameter identifies the user document.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Stores leave requests for a specific user. Path-based ownership enforces that only the user can access their own leave requests. The 'userId' parameter identifies the user, and 'leaveRequestId' identifies the specific leave request.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) User with ID 'user123' can create a leave request under their profile.
     * @allow (get) User with ID 'user123' can read their own leave request.
     * @deny (create) User with ID 'user456' cannot create a leave request for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the leave request for 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Stores WAN/COC requests for a specific user.  Path-based ownership enforces that only the user can access their own WAN/COC requests. The 'userId' parameter identifies the user, and 'wancocRequestId' identifies the specific request.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) User with ID 'user123' can create a WAN/COC request under their profile.
     * @allow (get) User with ID 'user123' can read their own WAN/COC request.
     * @deny (create) User with ID 'user456' cannot create a WAN/COC request for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the WAN/COC request for 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Stores all leave requests that are pending review. The 'leaveRequestId' parameter identifies the specific leave request.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (get) Anyone can read leave requests that are pending review.
     * @deny (create) No one can create leave requests directly in this collection.
     * @deny (update) Only Records Admins and System Admins can update leave requests in this collection.
     *
     */
    match /to-process-leave/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false; // TODO: Add admin role validation once roles are established.
      allow delete: if false; // TODO: Add admin role validation once roles are established.
    }

    /**
     * @description Stores employee information. The 'employeeId' parameter identifies the employee document.
     * @path /employees/{employeeId}
     */
    match /employees/{employeeId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add admin role validation once roles are established.
      allow update: if false; // TODO: Add admin role validation once roles are established.
      allow delete: if false; // TODO: Add admin role validation once roles are established.
    }

    /**
     * @description Stores application user credentials and roles. The 'appUserId' parameter identifies the user document.
     * @path /app-users/{appUserId}
     */
    match /app-users/{appUserId} {
      allow get: if false;
      allow list: if false;
      allow create: if false; // TODO: Add admin role validation once roles are established.
      allow update: if false; // TODO: Add admin role validation once roles are established.
      allow delete: if false; // TODO: Add admin role validation once roles are established.
    }
  }
}