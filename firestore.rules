rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can read and write their own user document.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile with matching userId.
     * @allow (get, list, update, delete) - Authenticated user reads/modifies their own profile.
     * @deny (create) - Authenticated user attempts to create a profile with a mismatched userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Verified authentication
      function isSignedIn() {
        return request.auth != null;
      }

      // Access control function: is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Access control function: is the user the owner, and does the document exist?
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the owner can read and write their own leave requests.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) - Authenticated user creates a leave request under their own user ID.
     * @allow (get, list, update, delete) - Authenticated user reads/modifies their own leave requests.
     * @deny (create) - Authenticated user attempts to create a leave request under another user's ID.
     * @principle Enforces document ownership for writes and prevents unauthorized access.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      // Verified authentication
      function isSignedIn() {
        return request.auth != null;
      }

      // Access control function: is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Access control function: is the user the owner, and does the document exist?
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the owner can read and write their own WAN/COC requests.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) - Authenticated user creates a WAN/COC request under their own user ID.
     * @allow (get, list, update, delete) - Authenticated user reads/modifies their own WAN/COC requests.
     * @deny (create) - Authenticated user attempts to create a WAN/COC request under another user's ID.
     * @principle Enforces document ownership for writes and prevents unauthorized access.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      // Verified authentication
      function isSignedIn() {
        return request.auth != null;
      }

      // Access control function: is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Access control function: is the user the owner, and does the document exist?
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read and write leave requests pending review.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (get, list, create, update, delete) - Any user can read, create, update, and delete leave requests.
     * @principle Public read and write access for processing leave requests.
     */
    match /to-process-leave/{leaveRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to employee data, but restricts write access to authenticated users.
     * @path /employees/{employeeId}
     * @allow (get, list) - Any user can read employee data.
     * @allow (create, update, delete) - Only authenticated users can modify employee data.
     * @deny (create, update, delete) - Unauthenticated users cannot modify employee data.
     * @principle Public read access with authenticated write control.
     */
    match /employees/{employeeId} {
      // Verified authentication
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}