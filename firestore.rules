/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only
 * access their own data. All data is nested under /users/{userId} to
 * leverage path-based authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for a specific user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for a specific user.
 * - /to-process-leave/{leaveRequestId}: Stores leave requests pending review. Access to this collection is not defined in provided document. Default to no access.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations are protected by an authorization check.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // isOwner function checks if the uid of the user making the request matches the userId parameter
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to leave request documents for a specific user.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) User with ID 'user123' can create a leave request under their profile.
     * @allow (get) User with ID 'user123' can read a leave request under their profile.
     * @allow (update) User with ID 'user123' can update a leave request under their profile.
     * @allow (delete) User with ID 'user123' can delete a leave request under their profile.
     * @deny (create) User with ID 'user123' cannot create a leave request under 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to WAN/COC request documents for a specific user.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) User with ID 'user123' can create a WAN/COC request under their profile.
     * @allow (get) User with ID 'user123' can read a WAN/COC request under their profile.
     * @allow (update) User with ID 'user123' can update a WAN/COC request under their profile.
     * @allow (delete) User with ID 'user123' can delete a WAN/COC request under their profile.
     * @deny (create) User with ID 'user123' cannot create a WAN/COC request under 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    /**
     * @description Controls access to leave request documents pending review.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (create) No one can create to-process-leave documents
     * @allow (get) No one can get to-process-leave documents
     * @allow (update) No one can update to-process-leave documents
     * @allow (delete) No one can delete to-process-leave documents
     * @principle: No write permissions.
     */
    match /to-process-leave/{leaveRequestId} {
          allow get: if false;
          allow list: if false;
          allow create: if false;
          allow update: if false;
          allow delete: if false;
    }

    // ---- Helper functions ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}