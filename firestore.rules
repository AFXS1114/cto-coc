rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and manage their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if isSignedIn() && isOwner(userId)
     * @deny (get, create, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to manage their own leave requests.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) if isSignedIn() && request.resource.data.userId == userId
     * @allow (get, list, update, delete) if isSignedIn() && isOwner(userId)
     * @deny (get, list, create, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to manage their own WAN/COC requests.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) if isSignedIn() && request.resource.data.userId == userId
     * @allow (get, list, update, delete) if isSignedIn() && isOwner(userId)
     * @deny (get, list, create, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows access to leave requests that are pending review. Access should be limited to admin users only.
     * @path /to-process-leave/{leaveRequestId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Restricts access to a user's own data tree.
     */
    match /to-process-leave/{leaveRequestId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows access to leave requests that have been approved. Access should be limited to admin users only.
     * @path /processed-cto/{leaveRequestId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Restricts access to a user's own data tree.
     */
    match /processed-cto/{leaveRequestId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows access to leave requests that have been cancelled. Access should be limited to admin users only.
     * @path /cancelled-cto/{leaveRequestId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Restricts access to a user's own data tree.
     */
    match /cancelled-cto/{leaveRequestId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows read access to employee information. Write access should be restricted to authorized personnel only.
     * @path /employees/{employeeId}
     * @allow get: if false; // TODO: Consider if public read is acceptable, else add authentication
     * @allow list: if false;
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny create, update, delete: if true;
     * @principle Enforces role-based access control for writes.
     */
    match /employees/{employeeId} {
       function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows managing application user credentials and roles. Access should be restricted to authorized personnel only.
     * @path /app-users/{appUserId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Enforces role-based access control.
     */
    match /app-users/{appUserId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows access to WAN requests that are available to be attached to a leave. Access should be limited to authorized personnel only.
     * @path /filed-wan/{wanId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Restricts access to a user's own data tree.
     */
    match /filed-wan/{wanId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

     /**
     * @description Allows access to WAN requests that have been attached to an approved leave. Access should be limited to authorized personnel only.
     * @path /used-wan/{wanId}
     * @allow get, list: if false; // TODO: Add admin role check
     * @allow create, update, delete: if false; // TODO: Add admin role check
     * @deny get, list, create, update, delete: if true;
     * @principle Restricts access to a user's own data tree.
     */
    match /used-wan/{wanId} {
      function isAdmin() {
        return request.auth.token.admin == true;
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}