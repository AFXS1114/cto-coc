/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data and defines specific access controls for different collections.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profiles. Only the authenticated user can read/write their own profile.
 * - `/users/{userId}/leave_requests/{leaveRequestId}`: Stores leave requests. Only the owning user can manage these.
 * - `/users/{userId}/wancoc_requests/{wancocRequestId}`: Stores WAN/COC requests. Only the owning user can manage these.
 * - `/to-process-leave/{leaveRequestId}`: Stores leave requests pending review, intended for administrative access (not implemented in this prototype).
 * - `/processed-cto/{leaveRequestId}`: Stores leave requests that are approved, intended for administrative access (not implemented in this prototype).
 * - `/cancelled-cto/{leaveRequestId}`: Stores leave requests that have been cancelled, intended for administrative access (not implemented in this prototype).
 * - `/employees/{employeeId}`: Stores employee information, intended for administrative access (not implemented in this prototype).
 * - `/app-users/{appUserId}`: Stores application user credentials, intended for administrative access (not implemented in this prototype).
 * - `/filed-wan/{wanId}`: Stores available WAN requests, intended for administrative access (not implemented in this prototype).
 * - `/used-wan/{wanId}`: Stores used WAN requests, intended for administrative access, and updatable via rule.
 *
 * Key Security Decisions:
 * - Strict user-ownership is enforced for user profiles, leave requests, and WAN/COC requests.
 * - Administrative access is not fully implemented in this prototype and marked with `// TODO:` comments.
 * - Data validation is minimal in this prototyping phase, focusing on relational integrity and ownership.
 * - Listing of documents is generally restricted to the owner, unless explicitly intended to be public.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) if request.auth.uid == userId
     * @allow (create) if request.auth.uid == userId && request.resource.data.id == userId
     * @allow (update) if request.auth.uid == userId && resource.data.id == request.resource.data.id
     * @deny (delete) User profiles should not be deleted directly.
     * @principle Enforces document ownership and prevents unauthorized modifications.
     */
    match /users/{userId} {
      // Verified Identity: All operations require the user to be signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Ownership: Checks if the request is made by the owner of the document.
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Existence Check: Verifies the document exists for update/delete operations.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Controls access to leave requests for a specific user.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (get, list) if request.auth.uid == userId
     * @allow (create) if request.auth.uid == userId
     * @allow (update) if request.auth.uid == userId
     * @deny (delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      // Verified Identity: All operations require the user to be signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Ownership: Checks if the request is made by the owner of the document.
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Existence Check: Verifies the document exists for update/delete operations.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to WAN/COC requests for a specific user.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (get, list) if request.auth.uid == userId
     * @allow (create) if request.auth.uid == userId
     * @allow (update) if request.auth.uid == userId
     * @deny (delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      // Verified Identity: All operations require the user to be signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Ownership: Checks if the request is made by the owner of the document.
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Existence Check: Verifies the document exists for update/delete operations.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to leave requests pending review.  Administrative access is not fully implemented in this prototype.
     * @path /to-process-leave/{leaveRequestId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /to-process-leave/{leaveRequestId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to approved leave requests. Administrative access is not fully implemented in this prototype.
     * @path /processed-cto/{leaveRequestId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /processed-cto/{leaveRequestId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
     * @description Controls access to cancelled leave requests. Administrative access is not fully implemented in this prototype.
     * @path /cancelled-cto/{leaveRequestId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /cancelled-cto/{leaveRequestId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to employee information. Administrative access is not fully implemented in this prototype.
     * @path /employees/{employeeId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /employees/{employeeId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to app user credentials. Administrative access is not fully implemented in this prototype.
     * @path /app-users/{appUserId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /app-users/{appUserId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to available WAN requests. Administrative access is not fully implemented in this prototype.
     * @path /filed-wan/{wanId}
     * @deny (get, list, create, update, delete)
     * @principle Restricts access to administrative functions.
     */
    match /filed-wan/{wanId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
     * @description Controls access to used WAN requests.  Allows manual updates in the rule.
     * @path /used-wan/{wanId}
     * @allow (update) if true;
     * @deny (get, list, create, delete)
     * @principle Allows manual updates to used WAN requests.
     */
    match /used-wan/{wanId} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if true;
        allow delete: if false;
    }
  }
}