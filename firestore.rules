/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of use by allowing all read and write operations.
 *
 * Data Structure:
 * Data is organized into collections for users, leave requests, WAN/COC requests, employees, and app users.
 *
 * Key Security Decisions:
 * This ruleset does not impose any authorization restrictions, effectively making all data public and modifiable by anyone.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows all read and write operations on user documents.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on leave requests within a user's subcollection.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on WAN/COC requests within a user's subcollection.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on leave requests to be processed.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /to-process-leave/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on processed CTO leave requests.
     * @path /processed-cto/{leaveRequestId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /processed-cto/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on cancelled CTO leave requests.
     * @path /cancelled-cto/{leaveRequestId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /cancelled-cto/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on employee documents.
     * @path /employees/{employeeId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /employees/{employeeId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows all read and write operations on app user documents.
     * @path /app-users/{appUserId}
     * @allow (get, list, create, update, delete)
     * @principle Disables all authorization checks for prototyping.
     */
    match /app-users/{appUserId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}