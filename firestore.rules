/**
 * @fileoverview Firestore Security Rules for the Leave and WAN/COC Request Application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for leave requests and WAN/COC requests.
 * Users can only access their own data. The "employees" collection is open for reads.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for a specific user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for a specific user.
 * - /to-process-leave/{leaveRequestId}: Stores all leave requests that are pending review.
 * - /employees/{employeeId}: Stores employee information.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied (no `allow list: if true;` at the database root).
 * - All write operations require a valid, authenticated user (`request.auth != null`).
 * - The rules use path-based authorization to secure user-owned data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile document at /users/user123 if request.auth.uid == 'user123'.
     * @allow (get) - User with UID 'user123' can read their profile document at /users/user123.
     * @allow (update) - User with UID 'user123' can update their profile document at /users/user123.
     * @allow (delete) - User with UID 'user123' can delete their profile document at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile document at /users/user123.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows users to manage their own leave requests.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) - User with UID 'user123' can create a leave request under their profile.
     * @allow (get) - User with UID 'user123' can read a leave request under their profile.
     * @allow (update) - User with UID 'user123' can update a leave request under their profile.
     * @allow (delete) - User with UID 'user123' can delete a leave request under their profile.
     * @deny (create) - User with UID 'user456' cannot create a leave request under /users/user123/.
     * @principle Enforces document ownership for leave requests using path-based authorization.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows users to manage their own WAN/COC requests.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) - User with UID 'user123' can create a WAN/COC request under their profile.
     * @allow (get) - User with UID 'user123' can read a WAN/COC request under their profile.
     * @allow (update) - User with UID 'user123' can update a WAN/COC request under their profile.
     * @allow (delete) - User with UID 'user123' can delete a WAN/COC request under their profile.
     * @deny (create) - User with UID 'user456' cannot create a WAN/COC request under /users/user123/.
     * @principle Enforces document ownership for WAN/COC requests using path-based authorization.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows anyone to read leave requests that are pending review. Write access should be secured with a role-based check if roles are implemented.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (get) - Any user can read a leave request in the to-process-leave collection.
     * @deny (create) - Nobody can create leave requests directly under /to-process-leave collection without authentication.
     * @principle Allows public read access to leave requests pending review, with restricted write access.
     */
    match /to-process-leave/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Allows anyone to read employee information. Write access is denied.
      * @path /employees/{employeeId}
      * @allow (get) - Any user can read employee information.
      * @deny (create) - Nobody can create employee documents directly under /employees collection without authentication.
      *
      */
    match /employees/{employeeId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}