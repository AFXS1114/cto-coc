/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, leave requests, and WAN/COC requests.
 * It allows public read access to employee records, but restricts write access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests, accessible only to the owning user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests, accessible only to the owning user.
 * - /to-process-leave/{leaveRequestId}: Stores leave requests that are pending review; write operations are open to all authenticated users,
 * - /employees/{employeeId}: Stores employee records. Publicly readable, write access is open to all authenticated users.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Read-only collections are used for public data (e.g., employee records) where all users can view information.
 * - Ambiguous relationships default to strict owner-only access to prevent unintended data exposure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles, allowing only the user to access their own data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @allow (get) User with ID 'user123' can read their profile.
     * @deny (get) User with ID 'user456' cannot read 'user123's profile.
     * @allow (update) User with ID 'user123' can update their profile.
     * @deny (update) User with ID 'user456' cannot update 'user123's profile.
     * @allow (delete) User with ID 'user123' can delete their profile.
     * @deny (delete) User with ID 'user456' cannot delete 'user123's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures leave requests, allowing only the owning user to access them.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) User with ID 'user123' can create a leave request.
     * @deny (create) User with ID 'user456' cannot create a leave request for 'user123'.
     * @allow (get) User with ID 'user123' can read their leave request.
     * @deny (get) User with ID 'user456' cannot read 'user123's leave request.
     * @allow (update) User with ID 'user123' can update their leave request.
     * @deny (update) User with ID 'user456' cannot update 'user123's leave request.
     * @allow (delete) User with ID 'user123' can delete their leave request.
     * @deny (delete) User with ID 'user456' cannot delete 'user123's leave request.
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures WAN/COC requests, allowing only the owning user to access them.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) User with ID 'user123' can create a WAN/COC request.
     * @deny (create) User with ID 'user456' cannot create a WAN/COC request for 'user123'.
     * @allow (get) User with ID 'user123' can read their WAN/COC request.
     * @deny (get) User with ID 'user456' cannot read 'user123's WAN/COC request.
     * @allow (update) User with ID 'user123' can update their WAN/COC request.
     * @deny (update) User with ID 'user456' cannot update 'user123's WAN/COC request.
     * @allow (delete) User with ID 'user123' can delete their WAN/COC request.
     * @deny (delete) User with ID 'user456' cannot delete 'user123's WAN/COC request.
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures leave requests pending review, allowing any authenticated user to create and modify them.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (create) Any authenticated user can create a leave request to be processed.
     * @allow (get) Any user can read the leave requests pending review.
     * @allow (update) Any authenticated user can update a leave request.
     * @allow (delete) Any authenticated user can delete a leave request.
     * @principle Allows open read and write access to authenticated users for the purpose of reviewing and processing leave requests.
     */
    match /to-process-leave/{leaveRequestId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get, list: if true;
        allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Secures employee records, allowing public read access but authenticated user create and write access.
     * @path /employees/{employeeId}
     * @allow (get) Any user can read employee information.
     * @deny (create) Anonymous user cannot create an employee record.
     * @allow (update) Authenticated User can update an employee record.
     * @deny (delete) Anonymous user cannot delete an employee record.
     * @principle Provides public read access while restricting write access to logged-in users.
     */
    match /employees/{employeeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}