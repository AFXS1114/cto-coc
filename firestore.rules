/**
 * @fileoverview Firestore Security Rules for the Leave Request Application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for leave and WAN/COC requests,
 * meaning only the authenticated user can access their own data. Employee data is publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for each user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for each user.
 * - /to-process-leave/{leaveRequestId}: Stores all leave requests that are pending review.
 * - /employees/{employeeId}: Stores employee information.
 * - /app-users/{appUserId}: Stores application user credentials and roles.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and associated requests.
 * - Listing all users is disallowed for privacy reasons.
 * - The `employees` collection is publicly readable to allow the application to display employee information, such as names and positions.  Writes are not permitted to any client.
 *
 * Denormalization for Authorization:
 * - The `LeaveRequest` and `WANCOCRequest` entities include a `userId` field, enabling
 *   rules to verify ownership without additional reads.
 *
 * Structural Segregation:
 * - Private user data (leave requests, WAN/COC requests) is stored under the `/users/{userId}`
 *   path, while employee information is stored in a separate, publicly readable collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Only the authenticated user can read/write their own user profile.
     * @path /users/{userId}
     * @allow (create) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (create) - If the authenticated user is not signed in.
     * @deny (create) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (get) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (get) - If the authenticated user is not signed in.
     * @deny (get) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (update) - If the authenticated user's ID matches the 'userId' parameter and the user profile exists.
     * @deny (update) - If the authenticated user is not signed in.
     * @deny (update) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (update) - If the user profile does not exist.
     * @allow (delete) - If the authenticated user's ID matches the 'userId' parameter and the user profile exists.
     * @deny (delete) - If the authenticated user is not signed in.
     * @deny (delete) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (delete) - If the user profile does not exist.
     * @deny (list) - Listing all users is not permitted.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Only the authenticated user can manage their own leave requests.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (create) - If the authenticated user is not signed in.
     * @deny (create) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (get) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (get) - If the authenticated user is not signed in.
     * @deny (get) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (update) - If the authenticated user's ID matches the 'userId' parameter and the leave request exists.
     * @deny (update) - If the authenticated user is not signed in.
     * @deny (update) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (update) - If the leave request does not exist.
     * @allow (delete) - If the authenticated user's ID matches the 'userId' parameter and the leave request exists.
     * @deny (delete) - If the authenticated user is not signed in.
     * @deny (delete) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (delete) - If the leave request does not exist.
     * @allow (list) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (list) - If the authenticated user is not signed in.
     * @deny (list) - If the authenticated user's ID does not match the 'userId' parameter.
     * @principle Enforces document ownership and existence for writes.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Only the authenticated user can manage their own WAN/COC requests.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (create) - If the authenticated user is not signed in.
     * @deny (create) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (get) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (get) - If the authenticated user is not signed in.
     * @deny (get) - If the authenticated user's ID does not match the 'userId' parameter.
     * @allow (update) - If the authenticated user's ID matches the 'userId' parameter and the WAN/COC request exists.
     * @deny (update) - If the authenticated user is not signed in.
     * @deny (update) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (update) - If the WAN/COC request does not exist.
     * @allow (delete) - If the authenticated user's ID matches the 'userId' parameter and the WAN/COC request exists.
     * @deny (delete) - If the authenticated user is not signed in.
     * @deny (delete) - If the authenticated user's ID does not match the 'userId' parameter.
     * @deny (delete) - If the WAN/COC request does not exist.
     * @allow (list) - If the authenticated user's ID matches the 'userId' parameter.
     * @deny (list) - If the authenticated user is not signed in.
     * @deny (list) - If the authenticated user's ID does not match the 'userId' parameter.
     * @principle Enforces document ownership and existence for writes.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Stores all leave requests that are pending review.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (create) - if false; // TODO: Define rules for processing leave requests
     * @allow (get) - if false; // TODO: Define rules for processing leave requests
     * @allow (update) - if false; // TODO: Define rules for processing leave requests
     * @allow (delete) - if false; // TODO: Define rules for processing leave requests
     * @allow (list) - if false; // TODO: Define rules for processing leave requests
     * @principle Placeholder for leave processing logic.
     */
    match /to-process-leave/{leaveRequestId} {
        // TODO: These require more details on who can process leaves
        allow create: if false;
        allow get: if false;
        allow update: if false;
        allow delete: if false;
        allow list: if false;
    }

    /**
     * @description Stores employee information. Publicly readable, writes are denied.
     * @path /employees/{employeeId}
     * @allow (create) - if false;
     * @allow (get) - if true;
     * @allow (update) - if false;
     * @allow (delete) - if false;
     * @allow (list) - if true;
     * @principle Public read access, no write access.
     */
    match /employees/{employeeId} {
      allow create: if false;
      allow get: if true;
      allow update: if false;
      allow delete: if false;
      allow list: if true;
    }

    /**
     * @description Stores application user credentials and roles.
     * @path /app-users/{appUserId}
     * @allow (create) - if false; // TODO: Define rules for app user creation, e.g., only admins
     * @allow (get) - if false; // TODO: Define rules for app user access, e.g., only admins or self
     * @allow (update) - if false; // TODO: Define rules for app user updates, e.g., only admins or self
     * @allow (delete) - if false; // TODO: Define rules for app user deletion, e.g., only admins
     * @allow (list) - if false; // TODO: Should this ever be listable?  Probably not
     * @principle Placeholder for app user management logic.
     */
    match /app-users/{appUserId} {
        // TODO: These require more details on who can manage app users
        allow create: if false;
        allow get: if false;
        allow update: if false;
        allow delete: if false;
        allow list: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}