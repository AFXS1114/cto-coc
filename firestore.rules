/**
 * @fileoverview Firestore Security Rules for the Leave Request Application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (leave requests, WAN/COC requests)
 * and allows public read access for employee data, with no authorization required.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for a specific user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for a specific user.
 * - /to-process-leave/{leaveRequestId}: Stores leave requests pending review.
 * - /employees/{employeeId}: Stores employee information.
 *
 * Key Security Decisions:
 * - User-specific data (leave_requests, wancoc_requests) is strictly controlled by the owning user.
 * - Employees collection is publicly readable, but creation, update, and deletion are denied without authentication.
 * - No listing of the /users collection is allowed to prevent user enumeration.
 *
 * Denormalization for Authorization:
 * - The 'userId' field within leave and WAN/COC requests is used to enforce ownership, avoiding the need for `get()` calls to the /users collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Prevents listing of all users.
     * @path /users
     * @allow None - Listing is always denied.
     * @deny None - Listing is always denied.
     * @principle Prevents user enumeration.
     */
    match /users {
      allow list: if false;
    }

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get) User with ID 'user456' cannot read the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if false; // Prevent listing users

    }

    /**
     * @description Controls access to leave requests for a specific user.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) User with ID 'user123' can create a leave request under their profile.
     * @allow (get) User with ID 'user123' can read a leave request under their profile.
     * @allow (update) User with ID 'user123' can update a leave request under their profile.
     * @allow (delete) User with ID 'user123' can delete a leave request under their profile.
     * @deny (create) User with ID 'user456' cannot create a leave request under 'user123'.
     * @deny (get) User with ID 'user456' cannot read a leave request under 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to WAN/COC requests for a specific user.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) User with ID 'user123' can create a WAN/COC request under their profile.
     * @allow (get) User with ID 'user123' can read a WAN/COC request under their profile.
     * @allow (update) User with ID 'user123' can update a WAN/COC request under their profile.
     * @allow (delete) User with ID 'user123' can delete a WAN/COC request under their profile.
     * @deny (create) User with ID 'user456' cannot create a WAN/COC request under 'user123'.
     * @deny (get) User with ID 'user456' cannot read a WAN/COC request under 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to leave requests pending review.
     * @path /to-process-leave/{leaveRequestId}
     * @allow (get) Any authenticated user can get leave requests to process.
     * @allow (list) Any authenticated user can list leave requests to process.
     * @deny (create) No one should be able to create a leave request using this endpoint.
     * @deny (update) No one should be able to update a leave request using this endpoint.
     * @deny (delete) No one should be able to delete a leave request using this endpoint.
     */
    match /to-process-leave/{leaveRequestId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to employee information.
     * @path /employees/{employeeId}
     * @allow (get, list) Any user can read employee information.
     * @deny (create, update, delete) No user can create, update, or delete employee information without authentication.
     */
    match /employees/{employeeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}