/**
 * @fileoverview Firestore Security Rules for the Leave and WAN/COC Request Application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for leave requests and WAN/COC requests stored under user-specific subcollections.
 * It also governs access to employee and app user data, and WAN request documents.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profile information, accessible only by the user themselves.
 * - `/users/{userId}/leave_requests/{leaveRequestId}`: Stores leave requests, accessible only by the owning user.
 * - `/users/{userId}/wancoc_requests/{wancocRequestId}`: Stores WAN/COC requests, accessible only by the owning user.
 * - `/to-process-leave/{leaveRequestId}`: Stores leave requests pending review; access to this collection is not defined and defaults to public access.
 * - `/processed-cto/{leaveRequestId}`: Stores approved leave requests; access to this collection is not defined and defaults to public access.
 * - `/cancelled-cto/{leaveRequestId}`: Stores cancelled leave requests; access to this collection is not defined and defaults to public access.
 * - `/employees/{employeeId}`: Stores employee information; access to this collection is not defined and defaults to public access.
 * - `/app-users/{appUserId}`: Stores application user credentials and roles; access to this collection is not defined and defaults to public access.
 * - `/filed-wan/{wanId}`: Stores available WAN requests; access to this collection is not defined and defaults to public access.
 * - `/used-wan/{wanId}`: Stores used WAN requests; access to this collection is not defined and defaults to public access.
 * - `/rejected-wan/{wanId}`: Stores rejected WAN requests; access to this collection is not defined and defaults to public access.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied (no top-level `/users` collection).
 * - The security posture for ambiguous relationships (e.g., access to `/to-process-leave`) defaults to public access.
 * - All write operations are guarded by authorization checks.
 *
 * Denormalization for Authorization:
 * - The `userId` field is present in `LeaveRequest` and `WANCOCRequest` documents, allowing for ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profile data only to the user themselves.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user's UID matches the 'userId' path segment.
     * @deny (get, create, update, delete) if the user's UID does not match the 'userId' path segment.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to leave requests only to the owning user.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (get, create, update, delete) if the user's UID matches the 'userId' path segment.
     * @deny (get, create, update, delete) if the user's UID does not match the 'userId' path segment.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to WAN/COC requests only to the owning user.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (get, create, update, delete) if the user's UID matches the 'userId' path segment.
     * @deny (get, create, update, delete) if the user's UID does not match the 'userId' path segment.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Access to leave requests pending review is not defined and therefore defaults to public access.
     * @path /to-process-leave/{leaveRequestId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /to-process-leave/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to processed CTO requests is not defined and therefore defaults to public access.
     * @path /processed-cto/{leaveRequestId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /processed-cto/{leaveRequestId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to cancelled CTO requests is not defined and therefore defaults to public access.
     * @path /cancelled-cto/{leaveRequestId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /cancelled-cto/{leaveRequestId} {
     allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to employee information is not defined and therefore defaults to public access.
     * @path /employees/{employeeId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /employees/{employeeId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to app user credentials is not defined and therefore defaults to public access.
     * @path /app-users/{appUserId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /app-users/{appUserId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
     * @description Access to available WAN requests is not defined, therefore allowing public read access and denying writes.
     * @path /filed-wan/{wanId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /filed-wan/{wanId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to used WAN requests is not defined and therefore defaults to public access.
     * @path /used-wan/{wanId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /used-wan/{wanId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Access to rejected WAN requests is not defined and therefore defaults to public access.
     * @path /rejected-wan/{wanId}
     * @allow get, list: public read access.
     * @deny create, update, delete: no write access.
     */
    match /rejected-wan/{wanId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}