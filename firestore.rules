/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only
 * access their own data, with all data being nested under a user-specific
 * path. This promotes data privacy and prevents unauthorized access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/leave_requests/{leaveRequestId}: Stores leave requests for a specific user.
 * - /users/{userId}/wancoc_requests/{wancocRequestId}: Stores WAN/COC requests for a specific user.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the authenticated user.
 * - Listing of all users is disallowed for privacy reasons.
 *
 * Denormalization for Authorization:
 * The `LeaveRequest` and `WANCOCRequest` entities include a `userId` field,
 * which is redundant with the path. However, this denormalization is
 * REQUIRED for security rules on `create` operations. Specifically, the
 * `create` rule MUST validate that the incoming `userId` matches the
 * `request.auth.uid` to prevent a malicious client from creating data
 * "for" another user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - If the user's ID matches the requested userId.
     * @allow (get) - If the user's ID matches the requested userId.
     * @allow (update) - If the user's ID matches the requested userId.
     * @allow (delete) - If the user's ID matches the requested userId.
     * @allow (list) - Denied to prevent enumeration of users.
     * @deny (create) - If the user's ID does not match the requested userId.
     * @deny (get) - If the user's ID does not match the requested userId.
     *
     * @principle Enforces document ownership: only the user can read/write their own profile.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Manages access to leave request documents for a specific user.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (create) - If the user's ID matches the requested userId.
     * @allow (get) - If the user's ID matches the requested userId.
     * @allow (update) - If the user's ID matches the requested userId.
     * @allow (delete) - If the user's ID matches the requested userId.
     * @allow (list) - If the user's ID matches the requested userId.
     * @deny (create) - If the user's ID does not match the requested userId.
     * @deny (get) - If the user's ID does not match the requested userId.
     *
     * @principle Enforces document ownership: only the user can read/write their own leave requests.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
        
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Manages access to WAN/COC request documents for a specific user.
     * @path /users/{userId}/wancoc_requests/{wancocRequestId}
     * @allow (create) - If the user's ID matches the requested userId.
     * @allow (get) - If the user's ID matches the requested userId.
     * @allow (update) - If the user's ID matches the requested userId.
     * @allow (delete) - If the user's ID matches the requested userId.
     * @allow (list) - If the user's ID matches the requested userId.
     * @deny (create) - If the user's ID does not match the requested userId.
     * @deny (get) - If the user's ID does not match the requested userId.
     *
     * @principle Enforces document ownership: only the user can read/write their own WAN/COC requests.
     */
    match /users/{userId}/wancoc_requests/{wancocRequestId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
      allow list: if isOwner(userId);
    }
  }
}